[Unit]
Description=NAPI-Switch management backend (REST API)
# The bridge and its ports come from netplan/networkd; the daemon waits for
# them (up to 90 s), then reapplies the saved config.
After=systemd-networkd.service napi-mrp.service
Wants=systemd-networkd.service napi-mrp.service
# Never hang: a daemon that keeps dying (5 times in 10 min) reboots the board.
StartLimitIntervalSec=600
StartLimitBurst=5
StartLimitAction=reboot-force

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/sbin/napi-switchd -listen :8080
# Fed by the health watchdog while its probes return (see health.go); the
# daemon reboots the board itself when the switch hangs.
WatchdogSec=30
TimeoutStartSec=150
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
