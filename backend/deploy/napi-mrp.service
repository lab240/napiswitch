[Unit]
Description=MRP (IEC 62439-2) ring daemon for NAPI-Switch (Microchip mrp_server)
# napi-switchd creates the ring through the `mrp` client; without this
# daemon MRP is reported unavailable. Needs a kernel with CONFIG_BRIDGE_MRP.
Before=napi-switchd.service

[Service]
ExecStart=/usr/local/sbin/mrp_server
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
