+/* MRP (IEC 62439-2) multicast: MRP_Test and ring control frames, and
+ * MRP_InTest for interconnections.
+ */
+static const u8 ksz9477_mrp_dmac[][ETH_ALEN] = {
+	{ 0x01, 0x15, 0x4e, 0x00, 0x00, 0x01 },
+	{ 0x01, 0x15, 0x4e, 0x00, 0x00, 0x02 },
+	{ 0x01, 0x15, 0x4e, 0x00, 0x00, 0x03 },
+};
+
+static int ksz9477_mrp_static(struct ksz_device *dev, const u8 *addr,
+			      bool add)
+{
+	const u8 *shifts = dev->info->shifts;
+	const u32 *masks = dev->info->masks;
+	u32 static_table[4];
+	u32 mac_hi, mac_lo;
+	int index, err = 0;
+	int free = -1;
+	u32 data;
+
+	mac_hi = (addr[0] << 8) | addr[1];
+	mac_lo = (addr[2] << 24) | (addr[3] << 16) | (addr[4] << 8) | addr[5];
+
+	mutex_lock(&dev->alu_mutex);
+
+	for (index = 0; index < dev->info->num_statics; index++) {
+		data = (index << shifts[ALU_STAT_INDEX]) |
+			masks[ALU_STAT_READ] | ALU_STAT_START;
+		ksz_write32(dev, REG_SW_ALU_STAT_CTRL__4, data);
+		err = ksz9477_wait_alu_sta_ready(dev);
+		if (err)
+			goto exit;
+		ksz9477_read_table(dev, static_table);
+
+		if (!(static_table[0] & ALU_V_STATIC_VALID)) {
+			if (free < 0)
+				free = index;
+			continue;
+		}
+		if ((static_table[2] >> ALU_V_FID_S) == 0 &&
+		    (static_table[2] & ALU_V_MAC_ADDR_HI) == mac_hi &&
+		    static_table[3] == mac_lo)
+			break;
+	}
+
+	if (index == dev->info->num_statics) {
+		if (!add)
+			goto exit;
+		if (free < 0) {
+			err = -ENOSPC;
+			goto exit;
+		}
+		index = free;
+	}
+
+	memset(static_table, 0, sizeof(static_table));
+	if (add) {
+		/* To the CPU only, also from ports the ring protocol blocked:
+		 * the bridge runs MRP and forwards these frames in software.
+		 */
+		static_table[0] = ALU_V_STATIC_VALID;
+		static_table[1] = ALU_V_OVERRIDE | BIT(dev->cpu_port);
+		static_table[2] = mac_hi;
+		static_table[3] = mac_lo;
+	}
+	ksz9477_write_table(dev, static_table);
+
+	data = (index << shifts[ALU_STAT_INDEX]) | ALU_STAT_START;
+	ksz_write32(dev, REG_SW_ALU_STAT_CTRL__4, data);
+	err = ksz9477_wait_alu_sta_ready(dev);
+
+exit:
+	mutex_unlock(&dev->alu_mutex);
+	return err;
+}
+
+int ksz9477_mrp_trap(struct ksz_device *dev, bool enable)
+{
+	int i, err;
+
+	for (i = 0; i < ARRAY_SIZE(ksz9477_mrp_dmac); i++) {
+		err = ksz9477_mrp_static(dev, ksz9477_mrp_dmac[i], enable);
+		if (err && enable)
+			goto undo;
+	}
+	return 0;
+
+undo:
+	while (--i >= 0)
+		ksz9477_mrp_static(dev, ksz9477_mrp_dmac[i], false);
+	return err;
+}
