+/* No MRP offload in the chip: the bridge runs MRP in software. The
+ * switch only has to hand MRP frames to the CPU, also from a ring port the
+ * protocol set to blocking, which is what accepting sw_backup asks for.
+ */
+static int ksz_port_mrp_add(struct dsa_switch *ds, int port,
+			    const struct switchdev_obj_mrp *mrp)
+{
+	struct ksz_device *dev = ds->priv;
+
+	return dev->dev_ops->mrp_trap ? 0 : -EOPNOTSUPP;
+}
+
+static int ksz_port_mrp_del(struct dsa_switch *ds, int port,
+			    const struct switchdev_obj_mrp *mrp)
+{
+	struct ksz_device *dev = ds->priv;
+
+	return dev->dev_ops->mrp_trap ? 0 : -EOPNOTSUPP;
+}
+
+static int ksz_port_mrp_add_ring_role(struct dsa_switch *ds, int port,
+				      const struct switchdev_obj_ring_role_mrp *mrp)
+{
+	struct ksz_device *dev = ds->priv;
+	int err;
+
+	if (!dev->dev_ops->mrp_trap || !mrp->sw_backup)
+		return -EOPNOTSUPP;
+
+	if (!dev->mrp_trap_ports) {
+		err = dev->dev_ops->mrp_trap(dev, true);
+		if (err)
+			return err;
+	}
+	dev->mrp_trap_ports |= BIT(port);
+
+	return 0;
+}
+
+static int ksz_port_mrp_del_ring_role(struct dsa_switch *ds, int port,
+				      const struct switchdev_obj_ring_role_mrp *mrp)
+{
+	struct ksz_device *dev = ds->priv;
+
+	if (!dev->dev_ops->mrp_trap || !mrp->sw_backup)
+		return -EOPNOTSUPP;
+
+	if (!(dev->mrp_trap_ports & BIT(port)))
+		return 0;
+	dev->mrp_trap_ports &= ~BIT(port);
+	if (!dev->mrp_trap_ports)
+		return dev->dev_ops->mrp_trap(dev, false);
+
+	return 0;
+}
